# Autenticación
AUTH_SECRET=
AUTH_URL=
NEXTAUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Base de datos
DATABASE_URL=

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
ADMIN_EMAIL=

# Backend / API
NEXT_PUBLIC_BACKEND_ENDPOINT=
NEXT_PUBLIC_STORE_ID=
# ID del proveedor Culqi Web en tu API (ej. pp_27e6bfb8-6c67). Obligatorio para checkout Culqi.
NEXT_PUBLIC_CULQI_WEB_PROVIDER_ID=
SERVER_INTERNAL_KEY=
ORDER_UPDATE_SECRET=

# Clave para llamadas internas a /api/email/send-verification (registro, login con email no verificado).
# Usar valor aleatorio en producción.
SEND_VERIFICATION_INTERNAL_KEY=

# CORS para pagos Culqi (opcional; si no se define usa NEXTAUTH_URL)
CORS_ORIGIN=

# Rate limiting (opcional; true/false, default: true)
RATE_LIMIT_ENABLED=true
